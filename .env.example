# --- Auth -------------------------------------------------------------
# While AUTH_BYPASS=true (or while the Clerk keys below are empty) the app
# runs with a demo login page at /dev-login instead of Clerk.
AUTH_BYPASS=true

# Clerk keys (https://dashboard.clerk.com). Once filled in, set AUTH_BYPASS=false.
# Enable "Phone number" (SMS code) as a sign-in method in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma separated e-mails that become platform admins when they sign in with Clerk.
ADMIN_EMAILS=

# Optional: where the SQLite file lives (default ./data/app.db)
# DATABASE_PATH=./data/app.db
