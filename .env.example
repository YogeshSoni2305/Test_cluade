# ─── Auth ────────────────────────────────────────────────────────────────
# While AUTH_BYPASS=true (or the Clerk keys are empty) a demo login at /dev-login replaces Clerk.
AUTH_BYPASS=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# E-mails that become super admins on first Clerk sign-in (comma separated)
ADMIN_EMAILS=

# ─── Site ────────────────────────────────────────────────────────────────
# Public URL, used for SEO (sitemap, canonical, JSON-LD), share links and notification links
SITE_URL=http://localhost:3000
# Secret for signing form tokens. If empty, a random one is generated and stored in the database.
APP_SECRET=
# Protects GET /api/cron/housekeeping (send as "Authorization: Bearer <secret>")
CRON_SECRET=
# DATABASE_PATH=./data/app.db

# ─── Bot protection (optional) ───────────────────────────────────────────
# Cloudflare Turnstile — when both are set, public forms show and verify the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Minimum time (ms) between rendering a public form and submitting it. Default 1500.
# BOT_MIN_FILL_MS=1500

# ─── Notifications (optional) ────────────────────────────────────────────
# WhatsApp Cloud API with an approved template that takes 3 body params: title, body, link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# MSG91 Flow API (variables: title, body, link)
MSG91_AUTH_KEY=
MSG91_FLOW_ID=

# ─── Masked calling (optional) ───────────────────────────────────────────
# Exotel "connect two numbers" — both sides see only your ExoPhone
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
# EXOTEL_SUBDOMAIN=api.exotel.com
